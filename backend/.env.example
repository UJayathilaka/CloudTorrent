# Public hostname. Use <PUBLIC-IP>.sslip.io after assigning a stable public IPv4 address.
SERVER_DOMAIN=203-0-113-10.sslip.io

# Generate a long random value. Send it to the Android app only over HTTPS.
API_TOKEN=replace-with-a-long-random-secret

# Internal Docker Compose qBittorrent address
QBITTORRENT_URL=http://qbittorrent:8080
QBITTORRENT_USERNAME=admin
# Set this to the permanent password configured in qBittorrent Web UI.
QBITTORRENT_PASSWORD=replace-with-qbittorrent-password
